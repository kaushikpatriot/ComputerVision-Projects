, b[image==1] = colors[random.randrange(0, 10)]\n","  colored_mask = np.stack([r,g,b], axis=2)\n","  return colored_mask"],"metadata":{"id":"A_yULQ8-N9ul","executionInfo":{"status":"ok","timestamp":1723007103831,"user_tz":-330,"elapsed":2,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["def instance_segmentation(img_path, threshold=0.5, rect_th=3,\n","                          text_size=3, text_th=3, url=False):\n","  masks, boxes, pred_cls = get_prediction(img_path, threshold=threshold, url=url)\n","  if url:\n","    img = url_to_image(img_path) # If we have a url image\n","  else: # Local image\n","    img = cv2.imread(img_path)\n","  img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB) # For working with RGB images instead of BGR\n","  for i in range(len(masks)):\n","    rgb_mask = random_color_masks(masks[i])\n","    img = cv2.addWeighted(img, 1, rgb_mask, 0.5, 0)\n","    pt1 = tuple(int(x) for x in boxes[i][0])\n","    pt2 = tuple(int(x) for x in boxes[i][1])\n","    cv2.rectangle(img, pt1, pt2, color=(0, 255, 0), thickness=rect_th)\n","    cv2.putText(img, pred_cls[i], pt1, cv2.FONT_HERSHEY_SIMPLEX, text_size, (0, 255, 0), thickness=text_th)\n","  return img, pred_cls, masks[i]"],"metadata":{"id":"iunCzkbcOAk7","executionInfo":{"status":"ok","timestamp":1723007106404,"user_tz":-330,"elapsed":407,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["!wget https://farm66.staticflickr.com/65535/40888877173_855795c875_o.png"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XRtS-oD5ODCm","executionInfo":{"status":"ok","timestamp":1723007210988,"user_tz":-330,"elapsed":1254,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}},"outputId":"3b6a1e1f-74a8-412e-83f5-3a34ace51b14"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["--2024-08-07 05:06:50--  ht